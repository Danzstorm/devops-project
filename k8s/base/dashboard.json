{
  "title": "linkshort",
  "uid": "linkshort",
  "tags": ["linkshort"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Peticiones por segundo, por codigo",
      "description": "Trafico partido por familia de codigo. Un salto en 5xx es un incidente; uno en 4xx suele ser un cliente que cambio.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"linkshort\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latencia p50 / p95 / p99",
      "description": "La media miente: esconde justo la cola que se queja. El p99 es el usuario que peor lo esta pasando.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"linkshort\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"linkshort\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"linkshort\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tasa de error (5xx)",
      "description": "Proporcion de peticiones que fallan por culpa nuestra. Es la mitad de un SLO: la otra mitad es la latencia.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{job=\"linkshort\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=\"linkshort\"}[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Replicas listas vs deseadas",
      "description": "Si 'listas' cae por debajo de 'deseadas' y no vuelve, hay pods fuera del balanceador: mirar /ready antes que los logs.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_ready{namespace=\"linkshort\",deployment=\"linkshort\"}",
          "legendFormat": "listas",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"linkshort\",deployment=\"linkshort\"}",
          "legendFormat": "deseadas",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memoria por pod",
      "description": "Contra el limite de 256Mi. Una linea que sube y nunca baja es una fuga, y acaba en OOMKill.",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"linkshort\",container=\"api\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    }
  ]
}
