# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# uv.lock SI se commitea: es lo que hace reproducible la instalacion.

# --- Entorno local ---
.env
*.local

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example
.terraform.lock.hcl.bak

# --- Kubernetes / secretos ---
kubeconfig
*.decrypted.yaml
age.key

# --- Editores / SO ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# Base de datos local de desarrollo (SQLite)
*.db

# El provider tehcyx/kind escribe el kubeconfig del cluster aqui, con nombre
# <cluster>-config. Lleva client-key-data: la CLAVE PRIVADA del cliente, en
# claro. Que una herramienta genere un secreto como efecto secundario, dentro
# del repositorio y sin avisar, es justo como se filtran.
terraform/*-config
